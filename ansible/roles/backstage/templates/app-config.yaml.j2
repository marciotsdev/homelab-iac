app:
  title: Homelab Backstage
  # Servido pelo Caddy (TLS) na mesma VM. Contexto seguro e obrigatorio: o
  # frontend usa crypto.randomUUID(), que so existe em https:// ou localhost.
  baseUrl: "{{ backstage_external_url }}"

  # Enable all packages by default, this will discover packages from packages/app/package.json
  packages: all

  extensions:
    # Configure the catalog index page to be the root page, this is normally mounted on /catalog
    - page:catalog:
        config:
          path: /

organization:
  name: Homelab

backend:
  baseUrl: "{{ backstage_external_url }}"
  listen:
    port: {{ backstage_port }}
    # So o Caddy (mesma VM) fala com o backend; a porta nao fica exposta na rede.
    host: 127.0.0.1
  reading:
    # Hosts de onde o catalogo pode ler catalog-info.yaml.
    allow:
      - host: "{{ hostvars['gitlab'].ansible_host }}:{{ gitlab_http_port }}"
      - host: "{{ hostvars['gitea'].ansible_host }}:{{ gitea_port }}"
  csp:
    connect-src: ["'self'", 'http:', 'https:']
    # As integracoes do lab (GitLab, AWX) sao http:; sem isso a CSP padrao do
    # helmet promove cada request a https: e quebra as chamadas.
    upgrade-insecure-requests: false
  cors:
    origin: "{{ backstage_external_url }}"
    methods: [GET, HEAD, PATCH, POST, PUT, DELETE]
    credentials: true
  database:
    client: better-sqlite3
    connection:
      directory: "{{ backstage_app_dir }}/data"
  actions:
    pluginSources:
      - auth
      - catalog
      - scaffolder

integrations:
  gitea:
    - host: "{{ hostvars['gitea'].ansible_host }}:{{ gitea_port }}"
      baseUrl: "http://{{ hostvars['gitea'].ansible_host }}:{{ gitea_port }}"
      password: ${GITEA_TOKEN}

proxy: {}

techdocs:
  builder: 'local'
  generator:
    runIn: 'local'
  publisher:
    type: 'local'

auth:
  environment: development
  providers:
    keycloak:
      development:
        clientId: "{{ backstage_keycloak_client_id }}"
        clientSecret: ${AUTH_KEYCLOAK_CLIENT_SECRET}
        baseUrl: "{{ keycloak_base_url }}"
        realm: "{{ keycloak_realm }}"
        signIn:
          resolvers:
            # Lab de um usuario so: sem sincronizar Users do Keycloak no
            # catalogo (plugin extra), entao qualquer login valido no realm
            # "homelab" e aceito sem exigir entidade User pre-existente.
            - resolver: preferredUsernameMatchingUserEntityName
              dangerouslyAllowSignInWithoutUserInCatalog: true
  clientIdMetadataDocuments:
    enabled: false

scaffolder:

catalog:
  import:
    entityFilename: catalog-info.yaml
    pullRequestBranchName: backstage-integration
  rules:
    - allow: [Component, System, API, Resource, Location, Group, User]
  locations:
    # Apps e automacoes: catalog-info.yaml versionado no GitLab.
    - type: url
      target: "{{ gitlab_url }}/root/{{ gitea_demo_repo }}/-/raw/main/catalog-info.yaml"
    - type: url
      target: "{{ gitlab_url }}/root/lab-ops/-/raw/main/catalog-info.yaml"
    # Infra sem repo proprio (emulador AWS e seu dashboard).
    - type: file
      target: "{{ backstage_app_dir }}/catalog/aws-local.yaml"

kubernetes:

permission:
  enabled: false

{% if enable_legacy_jenkins | default(false) | bool %}
jenkins:
  baseUrl: "http://{{ hostvars['jenkins'].ansible_host }}:{{ jenkins_port }}"
  username: "{{ jenkins_admin_user }}"
  apiKey: ${JENKINS_API_TOKEN}

{% endif %}
mcpActions:
  name: 'Homelab Backstage'
  description: 'Software catalog for the homelab (GitLab + AWX + containers)'
