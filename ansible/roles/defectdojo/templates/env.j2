# Gerado pelo papel Ansible defectdojo - nao editar a mao (sera sobrescrito).
# Os defaults do docker-compose.yml upstream sao credenciais PUBLICAS
# conhecidas (documentadas no proprio repo) - por isso todo valor sensivel
# abaixo e sobrescrito com um segredo real gerado uma unica vez.

DD_SECRET_KEY={{ defectdojo_secret_key }}
DD_CREDENTIAL_AES_256_KEY={{ defectdojo_credential_aes_key }}

DD_DATABASE_USER=defectdojo
DD_DATABASE_PASSWORD={{ defectdojo_db_password }}
DD_DATABASE_NAME=defectdojo
DD_DATABASE_URL=postgresql://defectdojo:{{ defectdojo_db_password }}@postgres:5432/defectdojo

DD_ALLOWED_HOSTS={{ defectdojo_allowed_hosts }}
DD_ADMIN_USER={{ defectdojo_admin_user }}
DD_ADMIN_MAIL={{ defectdojo_admin_mail }}
DD_ADMIN_FIRST_NAME={{ defectdojo_admin_first_name }}
DD_ADMIN_LAST_NAME={{ defectdojo_admin_last_name }}

# true so na primeira execucao (semear o banco) - depois disso o papel
# trava em false pra nao arriscar reprocessar a inicializacao num banco que
# ja tem dados reais. Ver tasks/main.yml (defectdojo_setup_marker).
DD_INITIALIZE={{ defectdojo_initialize }}

DD_PORT={{ defectdojo_port }}
