# Secrets — never commit
secrets/

# Terraform local state and artifacts (terraform/infra-base/, terraform/environments/*/, ...)
terraform/**/.terraform/
terraform/**/terraform.tfstate
terraform/**/terraform.tfstate.backup
terraform/**/terraform.tfstate.*.backup
terraform/**/tfplan.out
terraform/**/*.tfplan
terraform/**/crash.log
terraform/**/.pre-env-split-backup/

# Ansible
*.retry

# Environment-specific config (real IPs/paths) — commit the .example versions instead
ansible/inventory/hosts.ini
ansible/group_vars/all/hosts.yml
terraform/**/terraform.tfvars
